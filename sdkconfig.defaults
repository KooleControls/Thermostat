# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size and speed
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# HTTP server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# Increase timer task stack (default 2048 too small for WiFi calls in timer callbacks)
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# FAT long filename support (needed for React build output)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# OTA rollback — pairs with esp_ota_mark_app_valid_cancel_rollback() in main.cpp
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ── BLE (NimBLE) — the management link to the gateway ──────────
# We are the CENTRAL: the gateway advertises, we scan and connect. Peripheral and
# broadcaster roles stay at their defaults rather than being switched off, because
# the GAP service (device name) is a GATT-server service and needs them.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# One peer, ever: a thermostat pairs with exactly one gateway.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Persist bonding keys, so a reconnect never asks the installer for the install
# code again.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Ask for the largest practical MTU: one session chunk = one GATT write, so the
# MTU sets the chunk size and therefore the firmware-transfer rate.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
