# ──────────────────────────────────────────────────────────────
# Per-board sdkconfig overlay — DIYLESS Thermostat 3 (hw v3.3).
# Composed after the shared sdkconfig.defaults (root CMakeLists) and wins
# on conflicts. Target: ESP32-S3 (build dir configured with set-target esp32s3).
# ──────────────────────────────────────────────────────────────

# 8 MB flash with our 8 MB partition layout (two ~3.9 MB OTA slots, no www).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# 8 MB embedded octal PSRAM @ 80 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 240 MHz CPU.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── RGB panel: restart the GDMA every VBlank ────────────────
# This reverses the 2026-07-29 entry that said never to enable this. That entry
# was right about bounce-buffer mode and is now describing code we do not run.
#
# The symptom it addresses: a horizontally offset picture, appearing after
# minutes of normal use and then staying offset forever. In stream mode the
# panel has no pixel addressing — a pixel's position is only how many PCLKs
# have passed since VSYNC — so if the GDMA under-runs for a few clocks the LCD
# clocks out dummy bytes and the read pointer stays offset from the scan
# position permanently. IDF documents exactly this (rgb_lcd.rst: "leading to a
# permanently shifted image") and names this option as the fix.
#
# Why the old objection no longer applies: it was that the restart path re-fills
# BOTH bounce buffers, up to 19.2 KB of PSRAM memcpy, inside a VBlank only
# 1.98 ms wide, on a non-IRAM-safe ISR sharing core 0 with the BT controller.
# Read lcd_rgb_panel_try_restart_transmission() again with num_fbs 2 and
# bounce_buffer_size_px 0: every one of those memcpys is inside
# `if (panel->bb_size)`. With no bounce buffers the whole path is
# lcd_ll_fifo_reset + gdma_reset + gdma_start on the restart link — a handful
# of register writes, microseconds, nothing to miss a VBlank with. The cost that
# made it worse was a property of the buffer layout, not of the option, and
# DisplayManager::InitLvgl changed that layout.
#
# What is left of the objection, and still true: IDF's own comment warns a late
# restart shifts that one frame. In this mode that is a single frame instead of
# a permanent offset, which is the trade we want.
#
# Note also that without this option there is now NO recovery at all: the
# non-VSYNC detect branch compares bb_eof_count against expect_eof_count, and
# expect_eof_count is 0 when there are no bounce buffers, so it never fires.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# What most likely stalls the GDMA here, unfixed by the above: an MSPI1 flash
# write disables the cache, and the panel's GDMA reads its PSRAM framebuffers
# through that cache. Every NVS commit is such a write, and several fire from
# ordinary use — ClimateManager::MaybeCommitSettings on a settled setpoint,
# HotWaterManager, the settings menu, NimBLE bond persistence — which is why the
# shift correlates with using the thing rather than with uptime.
#
# CONFIG_SPIRAM_XIP_FROM_PSRAM (= SPIRAM_FETCH_INSTRUCTIONS + SPIRAM_RODATA)
# removes that cause: with .text and .rodata in PSRAM a flash write no longer
# needs the cache off. It is deliberately NOT enabled yet, because it puts
# instruction fetch on the same MSPI the panel is reading from, and MSPI
# contention is the documented cause of every glitch this board has had. Enable
# it as its own experiment if the VBlank restart alone leaves a visible artifact.

# Console on USB-Serial/JTAG, NOT UART0. UART0's default pins are repurposed
# on this board: GPIO43 is the LCD reset and GPIO44 the STM32 boot pin — a
# UART0 console would bit-bang log traffic onto them.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Settings taken from the DIYLESS/ESPHome reference config ─────
# diyless-thermostat-3.yaml runs this exact panel with BLE enabled alongside it,
# and once ran the same esp_lcd config we did (num_fbs 1, 10-line bounce buffers,
# framebuffer in PSRAM, PLL160M, 10 MHz). That is what established the point
# below: the panel setup is not what separates a smooth board from a glitchy one,
# the build settings are. We have since left the vendor config in one place —
# direct mode into two PSRAM framebuffers (see DisplayManager::InitLvgl) — so it
# is no longer a like-for-like comparison, and a glitch that appears now is worth
# blaming on that before blaming these.
#
# The pixel clock is NOT one of those places, though it briefly was: 16 MHz was
# tried and visibly tore the picture apart. See BoardConfig.h.
#
# A screen change is a full-screen redraw: 230400 px of software blending plus
# font rendering, flushed to PSRAM in 48 chunks. For that whole window core 1
# saturates the MSPI while the bounce-buffer ISR on core 0 needs a PSRAM read
# every 480 us. Halving the redraw window halves the contention, which is why
# the compiler flag matters to a *glitch* and not just to feel.
#
# ESPHome uses -Os; -O2 is faster still and flash is not tight here (the app
# uses 39 % of a 3 MB slot). Assertions stay on — the win is the optimizer.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ESPHome overrides IDF's 100 Hz default too. At 100 Hz the scheduler quantum
# is 10 ms, so LVGL's 33 ms refresh period lands on 40 ms and esp_lvgl_port's
# 5 ms tick becomes 10 ms. Touch polling and frame pacing both get coarse.
CONFIG_FREERTOS_HZ=1000

# Never referenced, and ESPHome force-disables them. Flash only, no runtime cost.
CONFIG_LV_BUILD_DEMOS=n

# LVGL — Montserrat font sizes used by the on-screen UI (14 is the only default).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
